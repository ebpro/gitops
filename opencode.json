{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "infrastructure/README.md"
  ],
  "permission": {
    "bash": {
      "kubectl apply *": "deny",
      "kubectl patch *": "deny",
      "kubectl edit *": "deny",
      "kubectl set *": "ask",
      "kubectl scale *": "ask",
      "kubectl exec *": "ask",
      "kubectl delete *": "ask",
      "git push": "ask",
      "*": "allow"
    },
    "edit": "allow",
    "webfetch": "allow",
    "skill": "allow"
  }
}
